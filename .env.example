# ──────────────────────────────────────────────────────────
# Banking App — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────

# Database connection string.
# SQLite (development): file:./dev.db
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
DATABASE_URL="file:./dev.db"

# NextAuth.js
# ──────────────────────────────────────────────────────────
# NEXTAUTH_URL must match your app's deployment URL.
#   http://localhost:3000        → development
#   https://your-domain.com      → production
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET is used to encrypt cookies and tokens.
# Generate a strong random secret:
#   openssl rand -base64 32
#   (or) npx auth secret
NEXTAUTH_SECRET="change-me-to-a-random-secret-in-production"
