# ──────────────────────────────────────────────────────────
# Banking App — Environment Variables
# ──────────────────────────────────────────────────────────
# Copy this file to `.env` and fill in the values.
#   cp .env.example .env
# ──────────────────────────────────────────────────────────

# Database connection string.
# SQLite (development): file:./dev.db  (resolves to prisma/dev.db)
# PostgreSQL (production): postgresql://user:password@host:5432/dbname
# See docs/postgres-migration.md before switching providers.
DATABASE_URL="file:./dev.db"

# NextAuth.js
# ──────────────────────────────────────────────────────────
# NEXTAUTH_URL must match your app's deployment URL.
#   http://localhost:3000        → development
#   https://your-domain.com      → production
NEXTAUTH_URL="http://localhost:3000"

# NEXTAUTH_SECRET is used to encrypt cookies and tokens.
# Generate a strong random secret:
#   openssl rand -base64 32
#   (or) npx auth secret
NEXTAUTH_SECRET="change-me-to-a-random-secret-in-production"

# Public site URL, used for metadata (Open Graph, canonical links).
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ──────────────────────────────────────────────────────────
# Background jobs
# ──────────────────────────────────────────────────────────
# Shared secret for the job runner endpoint:
#   curl -X POST $NEXTAUTH_URL/api/jobs/run -H "Authorization: Bearer $JOBS_SECRET"
# Point a cron job, a systemd timer or a platform scheduler at it to process
# scheduled transfers and interest accrual without visiting the dashboard.
JOBS_SECRET="change-me-too"

# ──────────────────────────────────────────────────────────
# Rate limiting
# ──────────────────────────────────────────────────────────
# "memory"   → per-process counters (default; fine for one instance)
# "database" → counters in the RateLimitEntry table (needed for multi-instance)
RATE_LIMIT_DRIVER="memory"

# ──────────────────────────────────────────────────────────
# Fees
# ──────────────────────────────────────────────────────────
# Flat fee charged when a transfer leaves the sandbox user, in cents.
# 0 disables the fee entirely. Transfers between your own accounts are free.
EXTERNAL_TRANSFER_FEE_CENTS="100"
